{
  "name": "@drewc/mail",
  "version": "0.1.0",
  "description": "A webapp mail client for notmuch, served from a podman container",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "server": "bun server/index.ts",
    "check": "tsc && tsc -p server",
    "podman:build": "podman build --format docker -t localhost/drewcmail -f Containerfile .",
    "podman:run": "sh container/run.sh",
    "podman:dev": "sh container/dev.sh"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@spinal/shadow-css": "link:packages/@spinal/shadow-css",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.0",
    "lit": "^3.3.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
